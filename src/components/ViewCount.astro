---
/**
 * Per-page view counter. Hidden until the analytics provider returns a count
 * (GoatCounter, once its visitor-counter setting is on and data exists).
 * `path` is the site path used as the counting key.
 */
interface Props {
  path: string;
}

const { path } = Astro.props;
---

<span class="view-count" data-count-path={path} hidden></span>

<script>
  import { getPageViews } from '../analytics/provider';

  for (const el of document.querySelectorAll<HTMLElement>('.view-count[data-count-path]')) {
    getPageViews(el.dataset.countPath!).then((n) => {
      if (n === null) return;
      el.textContent = `${n.toLocaleString('en-US')} views`;
      el.hidden = false;
    });
  }
</script>
