---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../PostList.astro';
import { getPosts, groupByYear, type Kind } from '../../lib/posts';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  kind: Kind;
}

const { lang, kind } = Astro.props;
const TITLES: Record<Kind, string> = {
  papers: 'Papers',
  'non-fiction': 'Non-fiction',
  fiction: 'Fiction',
};
const title = TITLES[kind];
const alternatePath = `${lang === 'ko' ? '/en' : ''}/${kind}/`;
const years = groupByYear(await getPosts(lang, kind));
---

<BaseLayout lang={lang} title={title} alternatePath={alternatePath}>
  <h1 class="page-title">{title}</h1>
  {years.length === 0 && <p class="muted">No posts yet.</p>}
  {
    years.map(([year, posts]) => (
      <section class="year-group">
        <h2>{year}</h2>
        <PostList posts={posts} />
      </section>
    ))
  }
</BaseLayout>
