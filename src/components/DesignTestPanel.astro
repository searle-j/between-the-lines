---
// 임시 D-미세조정 패널 — 배경·링크색·코드(다크)·레이아웃을 실시간 전환.
// BaseLayout의 DESIGN_TEST 플래그로 함께 제거된다.
---

<aside class="dt" id="dt" data-open="true">
  <button type="button" class="dt-chip" id="dt-chip" title="D 미세조정 패널 열기">Aa</button>
  <div class="dt-body">
    <div class="dt-head">
      <span>D TUNE</span>
      <button type="button" id="dt-min" title="접기">–</button>
    </div>

    <div class="dt-row">
      <span class="dt-label">배경</span>
      <div class="dt-btns" data-k="bg">
        <button type="button" data-v="p0" title="#F5F1E8 — 원래 D">기존</button>
        <button type="button" data-v="p1" title="#F3EFE5 — 한 단계 차분 (추천)">①</button>
        <button type="button" data-v="p2" title="#F1EDE2 — 두 단계">②</button>
        <button type="button" data-v="p3" title="#F2EFE9 — 덜 노랗게">③</button>
      </div>
    </div>

    <div class="dt-row">
      <span class="dt-label">링크</span>
      <div class="dt-btns" data-k="link">
        <button type="button" data-v="l0" title="#76504F — 원래 D">기존</button>
        <button type="button" data-v="l1" title="#8E4642 — 진하게+채도 (추천)">진하게</button>
        <button type="button" data-v="l2" title="#A03E38 — 더 선명">선명</button>
      </div>
    </div>

    <div class="dt-row">
      <span class="dt-label">코드<small>·다크</small></span>
      <div class="dt-btns" data-k="code">
        <button type="button" data-v="warm" title="라이트와 같은 warm 계열">따뜻</button>
        <button type="button" data-v="rose" title="자줏빛 바탕 + 보석톤 (추천)">로제</button>
        <button type="button" data-v="gruv" title="Gruvbox dark">그루브</button>
        <button type="button" data-v="flex" title="Flexoki dark">플렉스</button>
      </div>
    </div>

    <div class="dt-row">
      <span class="dt-label">배치</span>
      <div class="dt-btns" data-k="layout">
        <button type="button" data-v="margin" title="와이드 화면: 내비 왼쪽 여백 · 토글 오른쪽 여백 (추천)">여백</button>
        <button type="button" data-v="top" title="기존 상단 헤더">상단</button>
      </div>
    </div>

    <div class="dt-name" id="dt-name"></div>
  </div>
</aside>

<style>
  .dt {
    position: fixed;
    right: 14px;
    bottom: 14px;
    z-index: 40;
    font-family: -apple-system, 'Segoe UI', 'Noto Sans KR', sans-serif;
    font-size: 12px;
    line-height: 1.4;
  }

  .dt-chip {
    display: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid #c9c5bb;
    background: #fffdf7;
    color: #3a3833;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(20, 20, 15, 0.12);
  }

  .dt[data-open='false'] .dt-chip {
    display: block;
  }

  .dt[data-open='false'] .dt-body {
    display: none;
  }

  .dt-body {
    width: 236px;
    padding: 10px;
    border: 1px solid #c9c5bb;
    border-radius: 10px;
    background: rgba(255, 253, 247, 0.96);
    color: #3a3833;
    box-shadow: 0 4px 16px rgba(20, 20, 15, 0.14);
    backdrop-filter: blur(4px);
  }

  html[data-theme='dark'] .dt-body,
  html[data-theme='dark'] .dt-chip {
    background: rgba(30, 30, 27, 0.96);
    border-color: #4a4a42;
    color: #d6d2c8;
  }

  .dt-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    opacity: 0.65;
    margin-bottom: 8px;
  }

  .dt-head button {
    border: none;
    background: none;
    color: inherit;
    cursor: pointer;
    font-size: 14px;
    line-height: 1;
    padding: 0 2px;
  }

  .dt-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 5px;
  }

  .dt-label {
    flex: none;
    width: 52px;
    font-size: 10.5px;
    opacity: 0.75;
  }

  .dt-label small {
    font-size: 9px;
  }

  .dt-btns {
    display: flex;
    flex: 1;
    gap: 4px;
  }

  .dt-btns button {
    flex: 1;
    border: 1px solid #c9c5bb;
    background: transparent;
    color: inherit;
    border-radius: 6px;
    padding: 3px 0;
    cursor: pointer;
    font-size: 11px;
    white-space: nowrap;
  }

  html[data-theme='dark'] .dt-btns button {
    border-color: #4a4a42;
  }

  .dt-btns button:hover {
    background: rgba(120, 115, 100, 0.12);
  }

  .dt-btns button[aria-pressed='true'] {
    background: #3a3833;
    border-color: #3a3833;
    color: #fffdf7;
  }

  html[data-theme='dark'] .dt-btns button[aria-pressed='true'] {
    background: #d6d2c8;
    border-color: #d6d2c8;
    color: #1e1e1b;
  }

  .dt-name {
    margin-top: 7px;
    font-size: 10px;
    opacity: 0.7;
    min-height: 1.2em;
  }

  @media (max-width: 640px) {
    .dt {
      right: 10px;
      bottom: 10px;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const panel = document.getElementById('dt')!;
  const nameEl = document.getElementById('dt-name')!;
  const groups = [...panel.querySelectorAll<HTMLElement>('.dt-btns')];

  function sync() {
    const state: string[] = [];
    for (const group of groups) {
      const key = group.dataset.k!;
      const current = root.dataset[key] ?? '';
      for (const b of group.querySelectorAll('button')) {
        b.setAttribute('aria-pressed', String(b.dataset.v === current));
        if (b.dataset.v === current) state.push(b.textContent!.trim());
      }
    }
    nameEl.textContent = state.join(' · ');
  }

  for (const group of groups) {
    const key = group.dataset.k!;
    group.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest('button');
      if (!button?.dataset.v) return;
      root.dataset[key] = button.dataset.v;
      try {
        localStorage.setItem(`d-${key}`, button.dataset.v);
      } catch {}
      sync();
    });
  }

  document.getElementById('dt-min')!.addEventListener('click', () => {
    panel.dataset.open = 'false';
  });
  document.getElementById('dt-chip')!.addEventListener('click', () => {
    panel.dataset.open = 'true';
  });

  sync();
</script>
