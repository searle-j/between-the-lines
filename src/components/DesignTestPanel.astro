---
// 임시 패널 — 남은 마지막 결정: 코드 블록 팔레트 (라이트/다크 쌍으로 전환).
// BaseLayout의 DESIGN_TEST 플래그로 함께 제거된다.
---

<aside class="dt" id="dt" data-open="true">
  <button type="button" class="dt-chip" id="dt-chip" title="코드 팔레트 패널 열기">Aa</button>
  <div class="dt-body">
    <div class="dt-head">
      <span>D TUNE · 코드 팔레트</span>
      <button type="button" id="dt-min" title="접기">–</button>
    </div>
    <div class="dt-btns" data-k="code">
      <button type="button" data-v="warm" title="light/dark 모두 D의 warm 계열">따뜻</button>
      <button type="button" data-v="rose" title="light: Rosé Pine Dawn · dark: Rosé Pine Main">로제</button>
      <button type="button" data-v="gruv" title="light: Gruvbox light · dark: Gruvbox dark">그루브</button>
      <button type="button" data-v="flex" title="light: Flexoki light · dark: Flexoki dark">플렉스</button>
    </div>
    <div class="dt-name">라이트·다크 팔레트가 함께 바뀝니다</div>
  </div>
</aside>

<style>
  .dt {
    position: fixed;
    right: 14px;
    bottom: 14px;
    z-index: 40;
    font-family: -apple-system, 'Segoe UI', 'Noto Sans KR', sans-serif;
    font-size: 12px;
    line-height: 1.4;
  }

  .dt-chip {
    display: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid #c9c5bb;
    background: #fffdf7;
    color: #3a3833;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(20, 20, 15, 0.12);
  }

  .dt[data-open='false'] .dt-chip {
    display: block;
  }

  .dt[data-open='false'] .dt-body {
    display: none;
  }

  .dt-body {
    width: 216px;
    padding: 10px;
    border: 1px solid #c9c5bb;
    border-radius: 10px;
    background: rgba(255, 253, 247, 0.96);
    color: #3a3833;
    box-shadow: 0 4px 16px rgba(20, 20, 15, 0.14);
    backdrop-filter: blur(4px);
  }

  html[data-theme='dark'] .dt-body,
  html[data-theme='dark'] .dt-chip {
    background: rgba(30, 30, 27, 0.96);
    border-color: #4a4a42;
    color: #d6d2c8;
  }

  .dt-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    opacity: 0.65;
    margin-bottom: 8px;
  }

  .dt-head button {
    border: none;
    background: none;
    color: inherit;
    cursor: pointer;
    font-size: 14px;
    line-height: 1;
    padding: 0 2px;
  }

  .dt-btns {
    display: flex;
    gap: 4px;
  }

  .dt-btns button {
    flex: 1;
    border: 1px solid #c9c5bb;
    background: transparent;
    color: inherit;
    border-radius: 6px;
    padding: 4px 0;
    cursor: pointer;
    font-size: 11.5px;
    white-space: nowrap;
  }

  html[data-theme='dark'] .dt-btns button {
    border-color: #4a4a42;
  }

  .dt-btns button:hover {
    background: rgba(120, 115, 100, 0.12);
  }

  .dt-btns button[aria-pressed='true'] {
    background: #3a3833;
    border-color: #3a3833;
    color: #fffdf7;
  }

  html[data-theme='dark'] .dt-btns button[aria-pressed='true'] {
    background: #d6d2c8;
    border-color: #d6d2c8;
    color: #1e1e1b;
  }

  .dt-name {
    margin-top: 7px;
    font-size: 10px;
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .dt {
      right: 10px;
      bottom: 10px;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const panel = document.getElementById('dt')!;
  const buttons = [...panel.querySelectorAll<HTMLButtonElement>('.dt-btns button')];

  function sync() {
    const current = root.dataset.code ?? 'rose';
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.v === current));
  }

  for (const b of buttons) {
    b.addEventListener('click', () => {
      root.dataset.code = b.dataset.v!;
      try {
        localStorage.setItem('d-code', b.dataset.v!);
      } catch {}
      sync();
    });
  }

  document.getElementById('dt-min')!.addEventListener('click', () => {
    panel.dataset.open = 'false';
  });
  document.getElementById('dt-chip')!.addEventListener('click', () => {
    panel.dataset.open = 'true';
  });

  sync();
</script>
