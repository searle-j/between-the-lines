---
// 태그 페이지의 다중 태그 필터 — 현재 태그와 함께 붙은(co-occurring) 태그를
// 우측 여백에 표시하고(Toc와 같은 배치 규칙), 선택하면 목록을 AND 조건으로
// 좁힌다. 선택 상태는 `?and=tag1,tag2`로 URL에 반영되어 공유·새로고침에도
// 유지된다. 정적 사이트이므로 필터링은 전부 클라이언트에서 일어난다.
interface Props {
  tags: Array<{ tag: string; count: number }>;
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <aside class="tag-refine" aria-label="Filter by additional keyword">
      <div class="refine-title">Also tagged</div>
      <ul>
        {tags.map(({ tag, count }) => (
          <li>
            <button type="button" data-tag={tag} aria-pressed="false">
              <span class="refine-tag">#{tag}</span>
              <span class="refine-count">{count}</span>
            </button>
          </li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .tag-refine {
    display: none;
  }

  /* Toc와 같은 규칙: 여백형 레이아웃의 오른쪽 여백이 충분할 때만 표시 */
  @media (min-width: 1280px) {
    .tag-refine {
      display: block;
      position: fixed;
      top: 7.5rem;
      right: 2.25rem;
      width: 190px;
      max-height: calc(100vh - 10rem);
      overflow-y: auto;
      font-size: 0.8rem;
      line-height: 1.5;
      word-break: keep-all;
    }

    .refine-title {
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.6rem;
    }

    .tag-refine ul {
      list-style: none;
      margin: 0;
      padding: 0;
      border-left: 1px solid var(--border);
    }

    .tag-refine li {
      margin: 0.1rem 0;
    }

    .tag-refine button {
      display: flex;
      align-items: baseline;
      gap: 0.45em;
      width: 100%;
      padding: 0.15rem 0 0.15rem 0.75rem;
      margin-left: -1px;
      border: none;
      border-left: 1px solid transparent;
      background: none;
      font: inherit;
      text-align: left;
      color: var(--muted);
      cursor: pointer;
    }

    .tag-refine button:hover:not(:disabled) {
      color: var(--link-hover);
    }

    .tag-refine button[aria-pressed='true'] {
      color: var(--text);
      border-left-color: var(--link);
    }

    .tag-refine button:disabled {
      opacity: 0.35;
      cursor: default;
    }

    .refine-count {
      color: var(--muted);
      font-family: var(--font-meta);
      font-size: 0.78em;
    }
  }
</style>

<script>
  const refine = document.querySelector('.tag-refine');
  if (refine) {
    const items = [...document.querySelectorAll<HTMLElement>('.post-list li[data-tags]')].map(
      (li) => ({ li, tags: new Set((li.dataset.tags ?? '').split(' ').filter(Boolean)) })
    );
    const buttons = [...refine.querySelectorAll<HTMLButtonElement>('button[data-tag]')];
    const known = new Set(buttons.map((b) => b.dataset.tag));
    const meta = document.querySelector<HTMLElement>('[data-post-count]');
    const selected = new Set<string>();

    // ?and=tag1,tag2 복원 — 사이드바에 실재하는 태그만 받아들인다.
    for (const tag of (new URLSearchParams(location.search).get('and') ?? '').split(',')) {
      if (known.has(tag)) selected.add(tag);
    }

    const apply = () => {
      let visible = 0;
      const coCounts = new Map<string, number>();
      for (const { li, tags } of items) {
        const show = [...selected].every((tag) => tags.has(tag));
        li.toggleAttribute('data-filtered', !show);
        if (!show) continue;
        visible++;
        for (const tag of tags) coCounts.set(tag, (coCounts.get(tag) ?? 0) + 1);
      }

      for (const button of buttons) {
        const tag = button.dataset.tag!;
        const count = coCounts.get(tag) ?? 0;
        const on = selected.has(tag);
        button.querySelector('.refine-count')!.textContent = String(count);
        button.setAttribute('aria-pressed', String(on));
        // 선택해도 결과가 0이 될 조합은 처음부터 누를 수 없게 잠근다.
        button.disabled = !on && count === 0;
      }

      if (meta) {
        const also = [...selected].map((tag) => `#${tag}`).join(' ');
        meta.textContent =
          `${visible} ${visible === 1 ? 'post' : 'posts'}` + (also ? ` · with ${also}` : '');
      }

      const url = new URL(location.href);
      if (selected.size) url.searchParams.set('and', [...selected].join(','));
      else url.searchParams.delete('and');
      history.replaceState(null, '', url);
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const tag = button.dataset.tag!;
        if (selected.has(tag)) selected.delete(tag);
        else selected.add(tag);
        apply();
      });
    }

    if (selected.size) apply();
  }
</script>
