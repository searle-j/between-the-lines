---
import LanguageToggle from './LanguageToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../lib/url';
import { siteName, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternatePath?: string | null;
}

const { lang, alternatePath = null } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
const current = Astro.url.pathname.replace(/\/$/, '');

// 여백형(세로) 내비에서는 그룹 라벨과 들여쓰기로 위계가 보이고,
// 상단형(가로) 내비에서는 라벨 없이 평탄하게 흐른다.
const nav = [
  {
    group: 'Review',
    items: [
      { label: 'Papers', path: `${prefix}/papers/` },
      { label: 'Books', path: `${prefix}/books/` },
    ],
  },
  {
    group: 'Search',
    items: [
      { label: 'Keywords', path: `${prefix}/tags/` },
      { label: 'Full-text', path: `${prefix}/search/` },
    ],
  },
];
const about = { label: 'About', path: `${prefix}/about/` };
---

<header class="site-header">
  <div class="container header-inner">
    <a class="site-title" href={withBase(`${prefix}/`)}>{siteName}</a>
    <div class="controls">
      <LanguageToggle lang={lang} alternatePath={alternatePath} />
      <ThemeToggle />
    </div>
    <nav aria-label="Site">
      {
        nav.map(({ group, items }) => (
          <div class="nav-group">
            <span class="nav-group-label" aria-hidden="true">{group}</span>
            {items.map((item) => {
              const href = withBase(item.path);
              return (
                <a href={href} aria-current={current === href.replace(/\/$/, '') ? 'page' : undefined}>
                  {item.label}
                </a>
              );
            })}
          </div>
        ))
      }
      <a
        href={withBase(about.path)}
        aria-current={current === withBase(about.path).replace(/\/$/, '') ? 'page' : undefined}
      >
        {about.label}
      </a>
    </nav>
  </div>
</header>
