---
import { withBase } from '../lib/url';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
const rssPath = lang === 'en' ? '/en/rss.xml' : '/rss.xml';
---

<footer class="site-footer">
  <div class="container">
    <p>
      © {year} searle-j · Code:
      <a href="https://github.com/searle-j/between-the-lines/blob/main/LICENSE">MIT</a> · Content:
      <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>
    </p>
    <p>{t(lang).figuresNotice}</p>
    <p>
      <a href="https://github.com/searle-j/between-the-lines">GitHub</a> ·
      <a href={withBase(rssPath)}>RSS</a>
    </p>
  </div>
</footer>
