---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import ViewCount from '../components/ViewCount.astro';
import { isoDate, postPath, postTags, tagPath, type Post } from '../lib/posts';
import { withBase } from '../lib/url';

interface Props {
  post: Post;
  hasAlternate: boolean;
  headings?: MarkdownHeading[];
}

const { post, hasAlternate, headings = [] } = Astro.props;
const { title, date, description } = post.entry.data;
// 조회수 키는 count.js가 기록하는 값(= 브라우저의 실제 경로 = base 포함)과 같아야 한다.
const countPath = withBase(postPath(post));
const tags = postTags(post.entry);
const alternatePath = hasAlternate
  ? postPath({ ...post, lang: post.lang === 'ko' ? 'en' : 'ko' })
  : null;
---

<BaseLayout lang={post.lang} title={title} description={description} alternatePath={alternatePath}>
  <article class="post" data-pagefind-body>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <span class="meta-line">
          <time datetime={isoDate(date)}>{isoDate(date)}</time>
          <span aria-hidden="true">·</span>
          <span>{post.typeLabel}</span>
        </span>
        {
          tags.length > 0 && (
            <span class="post-meta-tags">
              {tags.map((tag) => (
                <a href={withBase(tagPath(post.lang, tag))}>#{tag}</a>
              ))}
            </span>
          )
        }
        <ViewCount path={countPath} />
      </div>
    </header>
    <hr />
    <div class="prose">
      <slot />
    </div>
  </article>
  <Toc headings={headings} />
</BaseLayout>
