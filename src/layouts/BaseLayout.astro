---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import '../styles/design-test.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DesignTestPanel from '../components/DesignTestPanel.astro';
import { withBase } from '../lib/url';
import { siteName, t, type Lang } from '../i18n/ui';

// 디자인 조합 테스트가 끝나면 false로 바꾸고, design-test.css import와
// DesignTestPanel, 아래 웹폰트 <link>들을 제거한 뒤 우승 조합을 global.css에 이식한다.
const DESIGN_TEST = true;

const GOOGLE_FONTS =
  'https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600&family=Geist+Mono:wght@400;500&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Sans+KR:wght@400;600&family=Instrument+Serif&family=Intel+One+Mono:wght@400;500&family=JetBrains+Mono:wght@400;500&family=Literata:opsz,wght@7..72,400;7..72,600&family=Newsreader:opsz,wght@6..72,400;6..72,600&family=Noto+Serif+KR:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /**
   * Site-relative path of this page in the other language, or null when no
   * counterpart exists (e.g. an untranslated post).
   */
  alternatePath?: string | null;
}

const { lang, title, description, alternatePath = null } = Astro.props;

const pageTitle = title ? `${title} · ${siteName}` : siteName;
const desc = description ?? t(lang).description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternateUrl = alternatePath ? new URL(withBase(alternatePath), Astro.site) : null;
const defaultUrl = lang === 'ko' ? canonical : alternateUrl;
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {
      alternateUrl && (
        <>
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link rel="alternate" hreflang={lang === 'ko' ? 'en' : 'ko'} href={alternateUrl} />
        </>
      )
    }
    {defaultUrl && <link rel="alternate" hreflang="x-default" href={defaultUrl} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} (KO)`} href={withBase('/rss.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} (EN)`} href={withBase('/en/rss.xml')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    {
      DESIGN_TEST && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
          <link rel="stylesheet" href={GOOGLE_FONTS} />
          <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
          />
          <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/gh/sunn-us/SUIT@latest/fonts/variable/woff2/SUIT-Variable.css"
          />
          <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/gh/wanteddev/wanted-sans@v1.0.3/packages/wanted-sans/fonts/webfonts/variable/split/WantedSansVariable.min.css"
          />
          <link rel="stylesheet" href="https://hangeul.pstatic.net/hangeul_static/css/maru-buri.css" />
          <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/monaspace-argon/index.css" />
        </>
      )
    }
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        document.documentElement.dataset.theme = stored ?? (media.matches ? 'dark' : 'light');
        if (!stored) {
          media.addEventListener('change', (e) => {
            document.documentElement.dataset.theme = e.matches ? 'dark' : 'light';
          });
        }
        /* design test: 마지막으로 고른 조합/질감 복원 (FOUC 방지) */
        try {
          const combo = localStorage.getItem('design-combo');
          if (combo) document.documentElement.dataset.combo = combo;
          const texture = localStorage.getItem('design-texture');
          if (texture) document.documentElement.dataset.texture = texture;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <Header lang={lang} alternatePath={alternatePath} />
    <main class="container">
      <slot />
    </main>
    <Footer lang={lang} />
    {DESIGN_TEST && <DesignTestPanel />}
  </body>
</html>
