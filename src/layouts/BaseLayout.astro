---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { withBase } from '../lib/url';
import { siteName, t, type Lang } from '../i18n/ui';

// 확정 디자인(D)의 폰트: 본문 Pretendard · 제목 Noto Serif KR ·
// 마스트헤드 Instrument Serif · 코드/메타 IBM Plex Mono
const GOOGLE_FONTS =
  'https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif&family=Noto+Serif+KR:wght@400;500;600&display=swap';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /**
   * Site-relative path of this page in the other language, or null when no
   * counterpart exists (e.g. an untranslated post).
   */
  alternatePath?: string | null;
  /** 404처럼 고유 URL이 없는 페이지: canonical·hreflang 대신 noindex를 낸다. */
  noindex?: boolean;
}

const { lang, title, description, alternatePath = null, noindex = false } = Astro.props;

const pageTitle = title ? `${title} · ${siteName}` : siteName;
const desc = description ?? t(lang).description;
const canonical = noindex ? null : new URL(Astro.url.pathname, Astro.site);
const alternateUrl =
  canonical && alternatePath ? new URL(withBase(alternatePath), Astro.site) : null;
const defaultUrl = lang === 'ko' ? canonical : alternateUrl;
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      canonical && alternateUrl && (
        <>
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link rel="alternate" hreflang={lang === 'ko' ? 'en' : 'ko'} href={alternateUrl} />
        </>
      )
    }
    {defaultUrl && <link rel="alternate" hreflang="x-default" href={defaultUrl} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} (KO)`} href={withBase('/rss.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} (EN)`} href={withBase('/en/rss.xml')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href={GOOGLE_FONTS} />
    {/* Pretendard 공식 배포 방식: 동적 서브셋 CSS (한글 글리프를 조각 단위로 로드) */}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <script is:inline>
      (() => {
        /* 기본 테마는 dark — 방문자가 토글로 light를 고르면 localStorage로 유지 */
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        document.documentElement.dataset.theme = stored === 'light' ? 'light' : 'dark';
      })();
    </script>
  </head>
  <body>
    <Header lang={lang} alternatePath={alternatePath} />
    <main class="container">
      <slot />
    </main>
    <Footer lang={lang} />
    <BackToTop />
    <script>
      // 저자 주석 팝오버 위치 보정 — 기본은 마커 위 중앙 정렬(CSS)이지만,
      // 화면 가장자리에서는 뷰포트 밖으로 나가므로 표시 시점에 측정해서
      // 수평으로 밀어 넣고(--shift), 위 공간이 없으면 아래로 편다(data-flip).
      for (const note of document.querySelectorAll<HTMLElement>('.author-note')) {
        const box = note.querySelector<HTMLElement>('.author-note-box');
        if (!box) continue;
        const clamp = () => {
          box.style.setProperty('--shift', '0px');
          box.removeAttribute('data-flip');
          const pad = 12;
          let rect = box.getBoundingClientRect();
          if (rect.top < pad) {
            box.setAttribute('data-flip', '');
            rect = box.getBoundingClientRect();
          }
          let shift = 0;
          if (rect.left < pad) shift = pad - rect.left;
          else if (rect.right > window.innerWidth - pad) shift = window.innerWidth - pad - rect.right;
          box.style.setProperty('--shift', `${shift}px`);
        };
        note.addEventListener('mouseenter', clamp);
        note.addEventListener('focusin', clamp);
      }
    </script>
    {
      /* GoatCounter 방문 집계 — 배포본에서만 (로컬 dev/preview 방문은 제외) */
      import.meta.env.PROD && (
        <script
          is:inline
          data-goatcounter="https://between-the-lines.goatcounter.com/count"
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </body>
</html>
