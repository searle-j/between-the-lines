---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import '../styles/design-test.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import DesignTestPanel from '../components/DesignTestPanel.astro';
import { withBase } from '../lib/url';
import { siteName, t, type Lang } from '../i18n/ui';

// D 미세조정이 끝나면 false로 바꾸고 design-test.css import와 DesignTestPanel을
// 제거한 뒤, 선택된 변형 값을 global.css에 이식한다. 폰트 <link>는 확정 디자인의
// 일부이므로 유지한다.
const DESIGN_TEST = true;

// 확정 디자인(D)의 폰트: 본문 Pretendard · 제목 Noto Serif KR ·
// 마스트헤드 Instrument Serif · 코드/메타 IBM Plex Mono
const GOOGLE_FONTS =
  'https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif&family=Noto+Serif+KR:wght@400;500;600&display=swap';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /**
   * Site-relative path of this page in the other language, or null when no
   * counterpart exists (e.g. an untranslated post).
   */
  alternatePath?: string | null;
}

const { lang, title, description, alternatePath = null } = Astro.props;

const pageTitle = title ? `${title} · ${siteName}` : siteName;
const desc = description ?? t(lang).description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternateUrl = alternatePath ? new URL(withBase(alternatePath), Astro.site) : null;
const defaultUrl = lang === 'ko' ? canonical : alternateUrl;
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {
      alternateUrl && (
        <>
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link rel="alternate" hreflang={lang === 'ko' ? 'en' : 'ko'} href={alternateUrl} />
        </>
      )
    }
    {defaultUrl && <link rel="alternate" hreflang="x-default" href={defaultUrl} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} (KO)`} href={withBase('/rss.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} (EN)`} href={withBase('/en/rss.xml')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href={GOOGLE_FONTS} />
    {/* Pretendard 공식 배포 방식: 동적 서브셋 CSS (한글 글리프를 조각 단위로 로드) */}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <script is:inline>
      (() => {
        /* 기본 테마는 dark — 방문자가 토글로 light를 고르면 localStorage로 유지 */
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        document.documentElement.dataset.theme = stored === 'light' ? 'light' : 'dark';
        /* design test: 코드 팔레트 복원 (기본값 = 로제) + 지난 테스트 키 정리 */
        try {
          for (const key of ['design-combo', 'design-texture', 'd-bg', 'd-link', 'd-layout']) {
            localStorage.removeItem(key);
          }
          document.documentElement.dataset.code = localStorage.getItem('d-code') ?? 'rose';
        } catch {}
      })();
    </script>
  </head>
  <body>
    <Header lang={lang} alternatePath={alternatePath} />
    <main class="container">
      <slot />
    </main>
    <Footer lang={lang} />
    <BackToTop />
    {DESIGN_TEST && <DesignTestPanel />}
  </body>
</html>
