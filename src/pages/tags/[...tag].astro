---
import TagPage from '../../components/pages/TagPage.astro';
import { getAllTags } from '../../lib/posts';

export async function getStaticPaths() {
  const [ko, en] = await Promise.all([getAllTags('ko'), getAllTags('en')]);
  const enTags = new Set(en.map(({ tag }) => tag));
  return ko.map(({ tag }) => ({
    params: { tag },
    props: { tag, hasAlternate: enTags.has(tag) },
  }));
}

const { tag, hasAlternate } = Astro.props;
---

<TagPage lang="ko" tag={tag} hasAlternate={hasAlternate} />
